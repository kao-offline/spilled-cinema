# Local transport
PORT=8787
HOST=127.0.0.1
SPILLED_NODE_MODE=local
SPILLED_NODE_DATABASE=/data/database/node.db
SPILLED_MASTER_KEY_FILE=/run/secrets/spilled_master_key
SPILLED_SECRET_RECORDS_FILE=/data/config/secrets.json
SPILLED_PUBLIC_TEMP_PATH=/data/tmp
SPILLED_VAULT_PATH=/data/vault

# Enable the public capabilities needed for search, import, and playback.
SPILLED_PUBLIC_CAPABILITIES=provider.search,provider.feed,provider.import,player.resolve

# Managed remote connectivity
SPILLED_GATEWAY_URL=https://nodes.spilled.overload.studio
SPILLED_GATEWAY_ENROLLMENT=replace-with-node-enrollment-credential
SPILLED_CONTROL_PLANE_JWKS_URL=https://replace-with-deployment.convex.site/server/v2/jwks
SPILLED_PASSKEY_ORIGIN=https://replace-node-id.nodes.spilled.overload.studio

# Legacy v1 registration remains off.
SPILLED_ENABLE_LEGACY_CONTROL_PLANE=0
