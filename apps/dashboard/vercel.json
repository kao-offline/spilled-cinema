{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/server/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/((?!api/|server/|assets/|worker-).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/artwork/refresh.ts": {
      "maxDuration": 60
    },
    "api/artwork/search.ts": {
      "maxDuration": 30
    },
    "api/node-proxy.js": {
      "maxDuration": 60
    }
  }
}
