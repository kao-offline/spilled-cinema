    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
