{
  "name": "@spilledcinema/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/standalone.ts",
    "build": "tsc --noEmit && esbuild src/standalone.ts --bundle --platform=node --format=esm --target=node22 --external:@node-rs/argon2 --external:node-datachannel --external:ws --outfile=dist/standalone.mjs",
    "start": "node dist/standalone.mjs",
    "start:dev": "tsx src/standalone.ts"
  },
  "dependencies": {
    "node-datachannel": "^0.31.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
