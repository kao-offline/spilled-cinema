{
  "manifest_version": 3,
  "name": "SpilledCinema Local Bridge",
  "version": "0.1.0",
  "description": "Bridges the SpilledCinema web app to a local runtime without exposing a public node URL.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://spilled.overload.studio/*",
    "https://*.vercel.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spilled.overload.studio/*",
        "https://*.vercel.app/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "SpilledCinema Local Bridge",
    "default_popup": "popup.html"
  }
}
